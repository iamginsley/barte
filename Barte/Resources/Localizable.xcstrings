        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The amounts don't add up to the expense."
          }
        }
      }
    },
    "Die Gruppe verschwindet bei dir. Die anderen behalten sie, dein Name bleibt in den Ausgaben stehen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The group disappears for you. The others keep it, and your name stays on the expenses."
          }
        }
      }
    },
    "Die Verbindung zu deiner Apple-ID konnte nicht getrennt werden. Dein Konto ist noch da. Versuch es gleich noch einmal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barte couldn't be disconnected from your Apple Account. Your account is still there. Please try again in a moment."
