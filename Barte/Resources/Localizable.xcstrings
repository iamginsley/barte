    },
    "Den Code findest du in der Einladung. Ein eingefügter Link geht auch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll find the code in the invite. A pasted link works too."
          }
