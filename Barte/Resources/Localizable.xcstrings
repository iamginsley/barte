      }
    },
    "Der Name muss zum Konto passen, sonst warnt die Bank bei der Überweisung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name has to match the account, or the bank will warn about the transfer."
